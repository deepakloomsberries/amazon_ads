# Amazon Ads API Credentials
AMAZON_CLIENT_ID=your_amazon_client_id
AMAZON_CLIENT_SECRET=your_amazon_client_secret
AMAZON_REFRESH_TOKEN=your_amazon_refresh_token

# AWS Credentials (used for Amazon Ads API region routing)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1

# Amazon Ads Profile (Saudi Arabia)
# Profile ID for Saudi Arabia marketplace - fetch from /v2/profiles endpoint
AMAZON_PROFILE_ID=your_sa_profile_id

# Amazon Ads API Settings
AMAZON_ADS_REGION=eu   # EU region serves Saudi Arabia (SA marketplace)
AMAZON_MARKETPLACE_ID=A17E79C6D8DWNP  # Amazon Saudi Arabia Marketplace ID

# Google BigQuery Settings
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/bq_service_account.json
BQ_PROJECT_ID=your_gcp_project_id
BQ_DATASET_ID=amazon_ads_sa
